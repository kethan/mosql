# Copy to .env - `loadEnv()` (and therefore the tests and the examples) reads it
# through dotenv when dotenv is installed. The names below are the only ones the
# project reads: the same three prefixes are used by the specs, the examples, the
# adapter factories and the CI services, so one file configures all of them.
#
# Ports have defaults (5432 / 3306 / 27017), so host + user + database are enough
# to enable a backend. A backend that is configured but unreachable is reported as
# a SKIP by the specs, not as a failure.
#
# Local servers: `docker compose up -d` starts all three with these values.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=test
PG_PASSWORD=secret
PG_DB=testdb

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=test
MYSQL_PASS=secret
MYSQL_DB=testdb

# MongoDB (used by the mongodb adapter; authSource is where the user is defined)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=secret
MONGO_DB=testdb
MONGO_AUTH_SOURCE=admin
